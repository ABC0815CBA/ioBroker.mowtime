{
  "type": "tabs",
  "items": {
    "general": { "type": "panel", "label": "Allgemein", "items": {
      "worxPrefix": { "type": "text", "label": "Worx-Datenpunktpräfix", "newLine": true },
      "intervalMinutes": { "type": "number", "label": "Berechnungsintervall", "unit": "min", "min": 1 },
      "mowingSpeed": { "type": "number", "label": "Mähleistung", "unit": "m²/h", "min": 1 },
      "growthMmPerWeek": { "type": "number", "label": "Simuliertes Wachstum", "unit": "mm/Woche", "min": 0 },
      "growthStartMm": { "type": "number", "label": "Zone einschalten ab Restwachstum", "unit": "mm", "min": 0 },
      "growthStopMm": { "type": "number", "label": "Zone ausschalten unter Restwachstum", "unit": "mm", "min": 0 },
      "referenceGrowthMm": { "type": "number", "label": "Referenzwachstum für einen Flächendurchgang", "unit": "mm", "min": 0.1 },
      "minTime": { "type": "number", "label": "MinTime (Freigabe-Hysterese)", "unit": "min", "min": 0 },
      "sequenceLength": { "type": "number", "label": "Länge der Zonensequenz", "min": 1, "max": 100 }
    }},
    "weather": { "type": "panel", "label": "Wetter-Datenpunkte", "items": {
      "weatherMode": { "type": "select", "label": "Wetterquelle", "options": [{"label":"Eigene ioBroker-Sensoren","value":"sensors"},{"label":"Open-Meteo (Internet)","value":"openmeteo"},{"label":"Bright Sky / DWD (Internet)","value":"brightsky"}] },
      "latitude": { "type": "number", "label": "Breitengrad", "min": -90, "max": 90 },
      "longitude": { "type": "number", "label": "Längengrad", "min": -180, "max": 180 },
      "weatherFailureMinutes": { "type": "number", "label": "Letzten Wetterwert bei Fehlern verwenden", "unit": "min", "min": 0 },
      "rainThreshold": { "type": "number", "label": "Regen ab Niederschlag", "unit": "mm", "min": 0 },
      "rainState": { "type": "objectId", "label": "Regen (boolean oder mm)" },
      "windState": { "type": "objectId", "label": "Windgeschwindigkeit" },
      "maxWind": { "type": "number", "label": "Wind-Sperrgrenze" },
      "temperatureState": { "type": "objectId", "label": "Außentemperatur" },
      "sunshineState": { "type": "objectId", "label": "Sonnenscheindauer heute (h)" },
      "et0State": { "type": "objectId", "label": "Referenz-Evapotranspiration heute (mm)" },
      "minTemperature": { "type": "number", "label": "Temperatur-Sperrgrenze", "unit": "°C" }
    }},
    "zones": { "type": "panel", "label": "Worx-Zonen", "items": {
      "_zoneHelp": { "type": "staticText", "text": "Worx-Zonen dienen nur der Verteilung der Mähzeit. Fläche, Boden und Schatten werden in den Teilflächen gepflegt." },
      "zone0Active": { "type": "checkbox", "label": "Worx-Zone 0 aktiv" },
      "zone1Active": { "type": "checkbox", "label": "Worx-Zone 1 aktiv" },
      "zone2Active": { "type": "checkbox", "label": "Worx-Zone 2 aktiv" },
      "zone3Active": { "type": "checkbox", "label": "Worx-Zone 3 aktiv" }
    }},
    "patchesPanel": { "type": "panel", "label": "Teilflächen", "items": {
      "_patchHelp": { "type": "staticText", "text": "Mehrere Teilflächen dürfen derselben Worx-Zone zugeordnet werden. Bodenfeuchte ist optional und wird in Prozent erwartet." },
      "patches": {
        "type": "table", "label": "Biologische Teilflächen", "clone": "name", "useCardFor": ["xs", "sm", "md"], "titleAttribute": "name",
        "items": [
          {"attr":"enabled","title":"Aktiv","type":"checkbox","default":true,"width":70},
          {"attr":"name","title":"Name","type":"text","default":"Teilfläche","width":150},
          {"attr":"mowerZone","title":"Worx-Zone","type":"select","default":0,"options":[{"label":"0","value":0},{"label":"1","value":1},{"label":"2","value":2},{"label":"3","value":3}],"width":100},
          {"attr":"area","title":"Fläche m²","type":"number","default":100,"min":0,"width":100},
          {"attr":"soil","title":"Boden","type":"select","default":"mixed","options":[{"label":"Sandig","value":"sandy"},{"label":"Sandig-Mischig","value":"sandyMixed"},{"label":"Mischerde","value":"mixed"},{"label":"Humus","value":"humus"},{"label":"Humus-Lehm","value":"humusLoam"},{"label":"Lehmig","value":"loamy"}],"width":150},
          {"attr":"fertilityFactor","title":"Fruchtbarkeit","type":"number","default":1,"min":0.3,"max":1.5,"step":0.05,"width":110},
          {"attr":"shade","title":"Schatten","type":"select","default":0,"options":[{"label":"Sonne","value":0},{"label":"Halbschatten","value":1},{"label":"Schatten","value":2}],"width":130},
          {"attr":"rootDepthCm","title":"Wurzeltiefe cm","type":"number","default":15,"min":5,"max":40,"width":120},
          {"attr":"rainFactor","title":"Regenfaktor","type":"number","default":1,"min":0,"max":2,"step":0.05,"width":110},
          {"attr":"moistureState","title":"Bodenfeuchte-Datenpunkt %","type":"text","default":"","width":220},
          {"attr":"growthStartMm","title":"Start mm","type":"number","default":3,"min":0,"width":95},
          {"attr":"growthStopMm","title":"Stopp mm","type":"number","default":0.5,"min":0,"width":95},
          {"attr":"minMowingMinutes","title":"Mindestbedarf min","type":"number","default":15,"min":0,"width":130}
        ]
      }
    }}
  }
}
