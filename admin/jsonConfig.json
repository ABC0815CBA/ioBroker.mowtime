{
  "type": "tabs",
  "items": {
    "sources": {
      "type": "panel",
      "label": {"de": "Datenpunkte", "en": "Data points"},
      "items": {
        "enableRainLock": {"type": "checkbox", "label": {"de": "Regensperre aktivieren", "en": "Enable rain lock"}, "newLine": true},
        "rainSource": {"type": "select", "label": {"de": "Quelle Regen", "en": "Rain source"}, "options": [{"label": {"de": "Eigener Datenpunkt", "en": "Local state"}, "value": "states"}, {"label": "Open-Meteo", "value": "openmeteo"}], "default": "states", "hidden": "!data.enableRainLock"},
        "enableGrowthWeatherAdjustment": {"type": "checkbox", "label": {"de": "Wetter-Wachstumsanpassung aktivieren", "en": "Enable weather growth adjustment"}, "newLine": true},
        "temperatureSource": {"type": "select", "label": {"de": "Quelle Temperatur", "en": "Temperature source"}, "options": [{"label": {"de": "Eigener Datenpunkt", "en": "Local state"}, "value": "states"}, {"label": "Open-Meteo", "value": "openmeteo"}], "default": "states", "hidden": "!data.enableGrowthWeatherAdjustment"},
        "moistureSource": {"type": "select", "label": {"de": "Quelle Bodenfeuchte", "en": "Soil moisture source"}, "options": [{"label": {"de": "Eigener Datenpunkt", "en": "Local state"}, "value": "states"}, {"label": "Open-Meteo", "value": "openmeteo"}], "default": "states", "hidden": "!data.enableGrowthWeatherAdjustment"},
        "lightSource": {"type": "select", "label": {"de": "Quelle Licht", "en": "Light source"}, "options": [{"label": {"de": "Eigener Datenpunkt", "en": "Local state"}, "value": "states"}, {"label": "Open-Meteo", "value": "openmeteo"}], "default": "states", "hidden": "!data.enableGrowthWeatherAdjustment"},
        "latitude": {"type": "number", "label": {"de": "Breitengrad (Open-Meteo)", "en": "Latitude (Open-Meteo)"}, "min": -90, "max": 90, "step": 0.0001, "hidden": "!((data.enableRainLock && data.rainSource === 'openmeteo') || (data.enableGrowthWeatherAdjustment && (data.temperatureSource === 'openmeteo' || data.moistureSource === 'openmeteo' || data.lightSource === 'openmeteo')))"},
        "longitude": {"type": "number", "label": {"de": "Längengrad (Open-Meteo)", "en": "Longitude (Open-Meteo)"}, "min": -180, "max": 180, "step": 0.0001, "hidden": "!((data.enableRainLock && data.rainSource === 'openmeteo') || (data.enableGrowthWeatherAdjustment && (data.temperatureSource === 'openmeteo' || data.moistureSource === 'openmeteo' || data.lightSource === 'openmeteo')))"},
        "onlineUpdateMinutes": {"type": "number", "label": {"de": "Open-Meteo-Aktualisierung (min)", "en": "Open-Meteo update interval (min)"}, "min": 15, "max": 360, "hidden": "!((data.enableRainLock && data.rainSource === 'openmeteo') || (data.enableGrowthWeatherAdjustment && (data.temperatureSource === 'openmeteo' || data.moistureSource === 'openmeteo' || data.lightSource === 'openmeteo')))"},
        "info": {"type": "staticText", "text": {"de": "Bei eigenen Datenpunkten muss Regen ein kumulativer mm-Zähler sein. Open-Meteo benötigt nur Koordinaten. Worx totalTime ist ein kumulativer Stundenzähler und wird intern in Minuten umgerechnet.", "en": "With local states, rain must be a cumulative mm counter. Open-Meteo only needs coordinates. Worx totalTime is a cumulative hour counter and is converted to minutes internally."}, "newLine": true},
        "rainStateId": {"type": "objectId", "label": {"de": "Regenmenge kumulativ (mm)", "en": "Cumulative rainfall (mm)"}, "hidden": "!data.enableRainLock || data.rainSource === 'openmeteo'"},
        "temperatureStateId": {"type": "objectId", "label": {"de": "Temperatur (°C)", "en": "Temperature (°C)"}, "hidden": "!data.enableGrowthWeatherAdjustment || data.temperatureSource === 'openmeteo'"},
        "moistureStateId": {"type": "objectId", "label": {"de": "Bodenfeuchte (%)", "en": "Soil moisture (%)"}, "hidden": "!data.enableGrowthWeatherAdjustment || data.moistureSource === 'openmeteo'"},
        "lightStateId": {"type": "objectId", "label": {"de": "Licht (Lux)", "en": "Light (lux)"}, "hidden": "!data.enableGrowthWeatherAdjustment || data.lightSource === 'openmeteo'"},
        "totalTimeStateId": {"type": "objectId", "label": {"de": "Worx totalTime (Stunden)", "en": "Worx totalTime (hours)"}},
        "statusStateId": {"type": "objectId", "label": "Worx Status"},
        "zoneStateId": {"type": "objectId", "label": {"de": "Technische Worx-Zone (0–3)", "en": "Technical Worx zone (0–3)"}},
        "mowTimeExtendedStateId": {"type": "objectId", "label": "Worx MowTimeExtended"},
        "calendarStateId": {"type": "objectId", "label": "calendar.calJson"},
        "calendar2StateId": {"type": "objectId", "label": "calendar.calJson2"},
        "mowingStatusValues": {"type": "text", "label": {"de": "Mäh-Statuswerte (Komma)", "en": "Mowing status values (comma separated)"}}
      }
    },
    "rain": {
      "type": "panel",
      "label": {"de": "Regensperre", "en": "Rain lock"},
      "items": {
        "rainThresholdMm": {"type": "number", "label": {"de": "Regen-Schwelle je Intervall (mm)", "en": "Rain threshold per interval (mm)"}, "min": 0, "step": 0.01},
        "rainDryHours": {"type": "number", "label": {"de": "Trockenzeit bis Freigabe (h)", "en": "Dry time before release (h)"}, "min": 0, "step": 0.5},
        "pollMinutes": {"type": "number", "label": {"de": "Auswertungsintervall (min)", "en": "Evaluation interval (min)"}, "min": 1, "max": 60}
      }
    },
    "zones": {
      "type": "panel",
      "label": {"de": "Zonen", "en": "Zones"},
      "items": {
        "zone1Minutes": {"type": "number", "label": {"de": "Zone 1 Basis-Sollzeit (min/Woche)", "en": "Zone 1 base target (min/week)"}, "min": 0},
        "zone1Soil": {"type": "select", "label": {"de": "Zone 1 Bodenart", "en": "Zone 1 soil type"}, "options": [{"label": {"de": "Sand", "en": "Sand"}, "value": "sand"}, {"label": {"de": "Sandiger Lehm", "en": "Sandy loam"}, "value": "sandyLoam"}, {"label": {"de": "Lehm/Mischboden", "en": "Loam"}, "value": "loam"}, {"label": {"de": "Toniger Boden", "en": "Clay"}, "value": "clay"}]},
        "zone2Minutes": {"type": "number", "label": {"de": "Zone 2 Basis-Sollzeit (min/Woche)", "en": "Zone 2 base target (min/week)"}, "min": 0},
        "zone2Soil": {"type": "select", "label": {"de": "Zone 2 Bodenart", "en": "Zone 2 soil type"}, "options": [{"label": {"de": "Sand", "en": "Sand"}, "value": "sand"}, {"label": {"de": "Sandiger Lehm", "en": "Sandy loam"}, "value": "sandyLoam"}, {"label": {"de": "Lehm/Mischboden", "en": "Loam"}, "value": "loam"}, {"label": {"de": "Toniger Boden", "en": "Clay"}, "value": "clay"}]},
        "zone3Minutes": {"type": "number", "label": {"de": "Zone 3 Basis-Sollzeit (min/Woche)", "en": "Zone 3 base target (min/week)"}, "min": 0},
        "zone3Soil": {"type": "select", "label": {"de": "Zone 3 Bodenart", "en": "Zone 3 soil type"}, "options": [{"label": {"de": "Sand", "en": "Sand"}, "value": "sand"}, {"label": {"de": "Sandiger Lehm", "en": "Sandy loam"}, "value": "sandyLoam"}, {"label": {"de": "Lehm/Mischboden", "en": "Loam"}, "value": "loam"}, {"label": {"de": "Toniger Boden", "en": "Clay"}, "value": "clay"}]},
        "zone4Minutes": {"type": "number", "label": {"de": "Zone 4 Basis-Sollzeit (min/Woche)", "en": "Zone 4 base target (min/week)"}, "min": 0},
        "zone4Soil": {"type": "select", "label": {"de": "Zone 4 Bodenart", "en": "Zone 4 soil type"}, "options": [{"label": {"de": "Sand", "en": "Sand"}, "value": "sand"}, {"label": {"de": "Sandiger Lehm", "en": "Sandy loam"}, "value": "sandyLoam"}, {"label": {"de": "Lehm/Mischboden", "en": "Loam"}, "value": "loam"}, {"label": {"de": "Toniger Boden", "en": "Clay"}, "value": "clay"}]}
      }
    },
    "model": {
      "type": "panel",
      "label": {"de": "Wachstumsmodell", "en": "Growth model"},
      "items": {
        "tempMin": {"type": "number", "label": {"de": "Kein Wachstum unter °C", "en": "No growth below °C"}},
        "tempOptLow": {"type": "number", "label": {"de": "Temperatur Optimum ab °C", "en": "Temperature optimum from °C"}},
        "tempOptHigh": {"type": "number", "label": {"de": "Temperatur Optimum bis °C", "en": "Temperature optimum to °C"}},
        "tempMax": {"type": "number", "label": {"de": "Kein Wachstum über °C", "en": "No growth above °C"}},
        "moistureDry": {"type": "number", "label": {"de": "Trockenpunkt (%)", "en": "Dry point (%)"}},
        "moistureOptLow": {"type": "number", "label": {"de": "Feuchte Optimum ab (%)", "en": "Moisture optimum from (%)"}},
        "moistureOptHigh": {"type": "number", "label": {"de": "Feuchte Optimum bis (%)", "en": "Moisture optimum to (%)"}},
        "moistureFlood": {"type": "number", "label": {"de": "Überschwemmungspunkt (%)", "en": "Flood point (%)"}},
        "lightLow": {"type": "number", "label": {"de": "Kein Wachstum unter (Lux)", "en": "No growth below (lux)"}},
        "lightOptimal": {"type": "number", "label": {"de": "Volles Licht ab (Lux)", "en": "Full light from (lux)"}}
      }
    }
  }
}
