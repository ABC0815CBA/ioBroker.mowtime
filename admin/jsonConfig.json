{
  "i18n": true,
  "type": "panel",
  "items": {
    "statesHeader": { "type": "header", "text": "Worx", "size": 2 },
    "worxBaseId": {
      "type": "objectId",
      "label": "Worx Basis-Datenpunkt",
      "help": "Wähle den Geräte-/Kanal-Datenpunkt des Mähroboters, z. B. worx.0.2021A0000007006076E5. Die benötigten Unterdatenpunkte werden automatisch daraus abgeleitet.",
      "types": ["device", "channel"],
      "root": "worx.0",
      "sm": 12,
      "md": 8
    },
    "worxInfo": {
      "type": "staticText",
      "text": "Aus dem gewählten Basis-Datenpunkt verwendet der Adapter automatisch die Worx-Unterdatenpunkte für Kalender, Blade-Time, Zone, Status und mowTimeExtend."
    },

    "weekHeader": { "type": "header", "text": "Mähwoche", "size": 2 },
    "weekStartDay": {
      "type": "select",
      "label": "Wochenstart",
      "help": "Legt fest, an welchem Wochentag um 00:00 Uhr eine neue Mähwoche beginnt. Statistik und verbleibende Mähzeiten werden bis zum Tag vor diesem Wochenstart berechnet.",
      "options": [
        { "label": "Montag", "value": 1 },
        { "label": "Dienstag", "value": 2 },
        { "label": "Mittwoch", "value": 3 },
        { "label": "Donnerstag", "value": 4 },
        { "label": "Freitag", "value": 5 },
        { "label": "Samstag", "value": 6 },
        { "label": "Sonntag", "value": 7 }
      ],
      "sm": 12,
      "md": 6
    },
    "weekInfo": {
      "type": "staticText",
      "text": "Beispiel: Wochenstart Mittwoch bedeutet Mittwoch 00:00 bis Dienstag 23:59. Beim Wechsel wird actualWeek nach pastWeek übernommen und actualWeek zurückgesetzt."
    },

    "slotsHeader": { "type": "header", "text": "Mähplan – Pflichtzeiten", "size": 2 },
    "slotsInfo": {
      "type": "staticText",
      "text": "Die 14 Worx-Zeiträume werden entsprechend dem gewählten Wochenstart sortiert. Gespeichert wird weiterhin die Pflicht/Optional-Zuordnung des echten Worx-Wochentags."
    },

