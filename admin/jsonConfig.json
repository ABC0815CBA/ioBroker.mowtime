{
  "i18n": true,
  "type": "panel",
  "items": {
    "statesHeader": { "type": "header", "text": "Worx", "size": 2 },
    "worxBaseId": {
      "type": "objectId",
      "label": "Worx Basis-Datenpunkt",
      "help": "Wähle den Geräte-/Kanal-Datenpunkt des Mähroboters, z. B. worx.0.2021A0000007006076E5. Die benötigten Unterdatenpunkte werden automatisch daraus abgeleitet.",
      "types": ["device", "channel"],
      "root": "worx.0",
      "sm": 12,
      "md": 8
    },
    "worxInfo": {
      "type": "staticText",
      "text": "Aus dem gewählten Basis-Datenpunkt verwendet der Adapter automatisch die Worx-Unterdatenpunkte für Kalender, Blade-Time, Zone, Status und mowTimeExtend."
    },

    "slotsHeader": { "type": "header", "text": "Mähplan – Pflichtzeiten", "size": 2 },
    "slotsInfo": {
      "type": "staticText",
      "text": "Die angezeigten Zeiten werden live aus calJson und calJson2 übernommen. Änderungen durch den Worx-Adapter erscheinen hier automatisch. Gespeichert wird nur, ob der jeweilige Slot Pflicht oder Optional ist."
    },

    "slotMandatory00": { "type": "checkbox", "label": "Kalender 1 Sonntag – Pflicht", "sm": 12, "md": 4 },
    "slotView00": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot00", "sm": 12, "md": 8 },
    "slotMandatory01": { "type": "checkbox", "label": "Kalender 1 Montag – Pflicht", "sm": 12, "md": 4 },
    "slotView01": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot01", "sm": 12, "md": 8 },
    "slotMandatory02": { "type": "checkbox", "label": "Kalender 1 Dienstag – Pflicht", "sm": 12, "md": 4 },
    "slotView02": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot02", "sm": 12, "md": 8 },
    "slotMandatory03": { "type": "checkbox", "label": "Kalender 1 Mittwoch – Pflicht", "sm": 12, "md": 4 },
    "slotView03": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot03", "sm": 12, "md": 8 },
    "slotMandatory04": { "type": "checkbox", "label": "Kalender 1 Donnerstag – Pflicht", "sm": 12, "md": 4 },
    "slotView04": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot04", "sm": 12, "md": 8 },
    "slotMandatory05": { "type": "checkbox", "label": "Kalender 1 Freitag – Pflicht", "sm": 12, "md": 4 },
    "slotView05": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot05", "sm": 12, "md": 8 },
    "slotMandatory06": { "type": "checkbox", "label": "Kalender 1 Samstag – Pflicht", "sm": 12, "md": 4 },
    "slotView06": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot06", "sm": 12, "md": 8 },

    "slotMandatory07": { "type": "checkbox", "label": "Kalender 2 Sonntag – Pflicht", "sm": 12, "md": 4 },
    "slotView07": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot07", "sm": 12, "md": 8 },
    "slotMandatory08": { "type": "checkbox", "label": "Kalender 2 Montag – Pflicht", "sm": 12, "md": 4 },
    "slotView08": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot08", "sm": 12, "md": 8 },
    "slotMandatory09": { "type": "checkbox", "label": "Kalender 2 Dienstag – Pflicht", "sm": 12, "md": 4 },
    "slotView09": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot09", "sm": 12, "md": 8 },
    "slotMandatory10": { "type": "checkbox", "label": "Kalender 2 Mittwoch – Pflicht", "sm": 12, "md": 4 },
    "slotView10": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot10", "sm": 12, "md": 8 },
    "slotMandatory11": { "type": "checkbox", "label": "Kalender 2 Donnerstag – Pflicht", "sm": 12, "md": 4 },
    "slotView11": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot11", "sm": 12, "md": 8 },
    "slotMandatory12": { "type": "checkbox", "label": "Kalender 2 Freitag – Pflicht", "sm": 12, "md": 4 },
    "slotView12": { "type": "state", "label": "Aktuelle Mähzeit", "oid": "schedule.slot12", "sm": 12, "md": 8 },
