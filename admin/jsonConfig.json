{
  "i18n": true,
  "type": "panel",
  "items": {
    "statesHeader": { "type": "header", "text": "Worx", "size": 2 },
    "worxBaseId": {
      "type": "objectId",
      "label": "Worx Basis-Datenpunkt",
      "help": "Wähle den Geräte-/Kanal-Datenpunkt des Mähroboters, z. B. worx.0.2021A0000007006076E5. Die benötigten Unterdatenpunkte werden automatisch daraus abgeleitet.",
      "types": ["device", "channel"],
      "root": "worx.0",
      "sm": 12,
      "md": 8
    },
    "worxInfo": {
      "type": "staticText",
      "text": "Aus dem gewählten Basis-Datenpunkt verwendet der Adapter automatisch folgende Worx-Datenpunkte:"
    },
    "worxCalJson": {
      "type": "pattern",
      "label": "Kalender 1",
      "pattern": "${data.worxBaseId}.calendar.calJson",
      "copyToClipboard": true,
      "sm": 12,
      "md": 6
    },
    "worxCalJson2": {
      "type": "pattern",
      "label": "Kalender 2",
      "pattern": "${data.worxBaseId}.calendar.calJson2",
      "copyToClipboard": true,
      "sm": 12,
      "md": 6
    },
    "worxBladeTime": {
      "type": "pattern",
      "label": "Gesamt-Messerlaufzeit",
      "pattern": "${data.worxBaseId}.mower.totalBladeTime",
      "copyToClipboard": true,
      "sm": 12,
      "md": 6
    },
    "worxArea": {
      "type": "pattern",
      "label": "Aktuelle Zone",
      "pattern": "${data.worxBaseId}.areas.actualArea",
      "copyToClipboard": true,
      "sm": 12,
      "md": 6
    },
    "worxStatus": {
      "type": "pattern",
      "label": "Mäherstatus",
      "pattern": "${data.worxBaseId}.mower.status",
      "copyToClipboard": true,
      "sm": 12,
      "md": 6
    },
    "worxMowTimeExtend": {
      "type": "pattern",
      "label": "Mähzeit-Erweiterung",
      "pattern": "${data.worxBaseId}.mower.mowTimeExtend",
      "copyToClipboard": true,
      "sm": 12,
      "md": 6
    },

    "slotsHeader": { "type": "header", "text": "Mähplan – Pflichtzeiten", "size": 2 },
    "slotsInfo": {
      "type": "staticText",
      "text": "Worx liefert beide Kalender in der Reihenfolge Sonntag bis Samstag. Bei den Beispieldaten sind die aktiven Fenster Mo–Fr 09:30–10:30 und Mo–Fr 20:00–21:00."
    },
    "mandatorySlots": {
      "type": "table",
      "label": "14 Slots: Index 0–6 = calJson So–Sa, Index 7–13 = calJson2 So–Sa",
      "items": [
        { "type": "checkbox", "attr": "mandatory", "title": "Pflicht" },
        { "type": "text", "attr": "label", "title": "Mähzeit", "disabled": true }
      ]
    },

    "rainHeader": { "type": "header", "text": "Regensperre", "size": 2 },
    "rainSource": { "type": "select", "label": "Regenquelle", "options": [
      { "label": "Open-Meteo", "value": "openmeteo" },
      { "label": "ioBroker Regensensor (mm/Tag)", "value": "state" }
    ]},
    "latitude": { "type": "number", "label": "Breitengrad", "hidden": "data.rainSource !== 'openmeteo'", "sm": 6 },
    "longitude": { "type": "number", "label": "Längengrad", "hidden": "data.rainSource !== 'openmeteo'", "sm": 6 },
    "rainState": { "type": "text", "label": "Regensensor Datenpunkt (mm/Tag)", "hidden": "data.rainSource !== 'state'" },
    "rainLockHours": { "type": "number", "label": "Regensperre (Stunden)", "min": 0, "step": 0.5 },

    "zonesHeader": { "type": "header", "text": "Soll-Mähzeiten", "size": 2 },
    "zonesInfo": {
      "type": "staticText",
      "text": "Nur die Sollzeit je Zone wird vorgegeben. Das Verhältnis der vier Zonen wird automatisch aus diesen Zeiten berechnet und unter Results ausgegeben."
    },
    "zone1Target": { "type": "number", "label": "Zone 1 Soll-Mähzeit (min)", "min": 0, "sm": 6, "md": 3 },
    "zone2Target": { "type": "number", "label": "Zone 2 Soll-Mähzeit (min)", "min": 0, "sm": 6, "md": 3 },
    "zone3Target": { "type": "number", "label": "Zone 3 Soll-Mähzeit (min)", "min": 0, "sm": 6, "md": 3 },
    "zone4Target": { "type": "number", "label": "Zone 4 Soll-Mähzeit (min)", "min": 0, "sm": 6, "md": 3 }
  }
}
